{
  "name": "ad-survey",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "firebase emulators:start --project demo-ad-survey --only auth,firestore,hosting",
    "seed": "node scripts/seed-emulator.mjs",
    "test": "npm run test:static && npm run test:rules",
    "test:static": "node --test tests/static/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-ad-survey --only firestore \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:hosting": "firebase deploy --only hosting",
    "seed:demo": "node scripts/seed-demo-responses.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.35.0"
  }
}
